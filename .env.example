# Dappersfit Environment Variables Configuration Template
# Copy this file to .env and fill in your actual values.

# Production Database (Supabase PostgreSQL)
# Example: postgresql://postgres.thxobtxrstnmjnwodxxs:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.thxobtxrstnmjnwodxxs.supabase.co:5432/postgres"

# Supabase Public & Secret Keys (Optional for client/storage integration)
SUPABASE_URL="https://thxobtxrstnmjnwodxxs.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."

# Store Details
NEXT_PUBLIC_STORE_NAME="Dappersfit Luxury Watches"
NEXT_PUBLIC_STORE_CONTACT="+91 75501 48991"
NEXT_PUBLIC_WHATSAPP_NUMBER=917550148991

# Cashfree Payments Gateway
# In Sandbox mode, Cashfree provides simulated test UPI & Card flows.
# When ready for live transactions, change CASHFREE_ENV to "production" and paste your Live App ID & Secret.
CASHFREE_APP_ID="CF_SANDBOX_DEMO_APP"
CASHFREE_SECRET_KEY="cf_sandbox_demo_secret_key_12345"
CASHFREE_ENV="sandbox"
