# Dappersfit Environment Variables Configuration Template
# Copy this file to .env and fill in your actual values.

# Production Database (Supabase PostgreSQL - Serverless Pooler Recommended for Vercel)
# Connection Pooler URL (IPv4 compatible, Port 6543, pgbouncer=true):
DATABASE_URL="postgresql://postgres.<project_ref>:[PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

# Session Pooler URL (IPv4 compatible, Port 5432, for Prisma migrations/db push):
DIRECT_URL="postgresql://postgres.<project_ref>:[PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Supabase Public & Secret Keys (Optional for client/storage integration)
SUPABASE_URL="https://thxobtxrstnmjnwodxxs.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."

# Store Details
NEXT_PUBLIC_STORE_NAME="Dappersfit Luxury Watches"
NEXT_PUBLIC_STORE_CONTACT="+91 93639 03915"
NEXT_PUBLIC_WHATSAPP_NUMBER=919363903915

# Cashfree Payments Gateway
# In Sandbox mode, Cashfree provides simulated test UPI & Card flows.
# When ready for live transactions, change CASHFREE_ENV to "production" and paste your Live App ID & Secret.
CASHFREE_APP_ID="CF_SANDBOX_DEMO_APP"
CASHFREE_SECRET_KEY="cf_sandbox_demo_secret_key_12345"
CASHFREE_ENV="sandbox"
