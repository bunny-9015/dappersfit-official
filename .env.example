# Dappersfit Environment Variables Configuration Template
# Copy this file to .env and fill in your actual values.

# Database
DATABASE_URL="file:./dev.db"

# Razorpay Payment Gateway
# 1. Sign up at https://dashboard.razorpay.com/signup
# 2. Complete basic business verification (individual / sole proprietorship / company)
# 3. Go to Account & Settings -> API Keys
# 4. Generate "Test Keys" (begins with rzp_test_...) for sandbox testing
# 5. When ready to accept real money, activate Live Mode and generate "Live Keys" (begins with rzp_live_...)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_dappersfitDemo
RAZORPAY_KEY_SECRET=dappersfitDemoSecretKey123

# Store Details
NEXT_PUBLIC_STORE_NAME="Dappersfit Luxury Watches"
NEXT_PUBLIC_STORE_CONTACT="+91 98765 43210"
